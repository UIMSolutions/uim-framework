buildRequirements "allowWarnings" "silenceDeprecations"
buildOptions "debugInfo" "ignoreDeprecations"

subPackage "core"
subPackage "oop"
subPackage "errors"
subPackage "jsons"
subPackage "services"
subPackage "xml"

