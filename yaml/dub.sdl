name "yaml"
description "uim library to work with Yaml"
homepage "https://www.sueel.de"
authors "Ozan Nurettin Süel"
copyright "Copyright © 2018 - 2026, ONS"
license "Apache-2.0"
dependency "uim-framework:core" path=".."
dependency "uim-framework:oop" path=".."
dependency "dyaml" version="~>0.10.0"
targetType "library"
targetPath "build"
targetName "uim-yaml"
sourcePaths "source"
importPaths "source"
configuration "default" {
	targetType "library"
}
configuration "modules" {
	targetType "library"
	versions "show_module"
}
configuration "tests" {
	targetType "library"
	versions "show_module" "show_test"
}
configuration "inits" {
	targetType "library"
	versions "show_module" "show_init"
}
configuration "calls" {
	targetType "library"
	versions "show_module" "show_test" "show_function"
}
configuration "verbose" {
	targetType "library"
	versions "show_module" "show_test" "show_init" "show_function"
}
