// Metadata
name "odbc"
description "D ODBC wrapper - object-oriented wrapper of the ODBC C API"
homepage "https://www.sueel.de/uim/odbc"
authors "Ozan Nurettin Süel"
copyright "Copyright © 2018 - 2026, ONS"
license "Apache-2.0"

// Target
targetName "uim-odbc"
targetType "library"

// Source
sourcePaths "source"
importPaths "source"

// Link to ODBC runtime
libs "odbc" platform="linux"
libs "odbc" platform="osx"
libs "odbc32" platform="windows"

// Configurations
configuration "default" {
    targetType "library"
}

configuration "modules" {
    targetType "library"
    versions "show_module"
}

configuration "tests" {
    targetType "library"
    versions "show_module" "show_test"
}

buildRequirements "allowWarnings" "silenceDeprecations"
buildOptions "ignoreDeprecations" "debugInfo"
