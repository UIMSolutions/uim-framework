name "services"
description "uim library to work with SERVICES"
homepage "https://www.sueel.de/uim/services"
authors "Ozan Nurettin Süel"
copyright "Copyright © 2018 - 2026, ONS"
license "Apache-2.0"

// target
targetName "uim-services"
targetType "library"
targetPath "build"

// Source and import paths
sourcePaths "source"
importPaths "source"

// dependencies
dependency "uim-framework:errors" version="*"
dependency "vibe-d" version="~>0.10.3"

// configurations
configuration "default" {
	targetType "library"
}

configuration "modules" {
	targetType "library"
	versions "show_module"
}

configuration "tests" {
	targetType "library"
	versions "show_module" "show_test"
}

configuration "inits" {
	targetType "library"
	versions "show_module" "show_init"
}

configuration "calls" {
	targetType "library"
	versions "show_module" "show_test" "show_function"
}

configuration "verbose" {
	targetType "library"
	versions "show_module" "show_test" "show_init" "show_function"
}

configuration "service" {
	targetType "executable"
	targetName "uim-services-api"
	mainSourceFile "source/app.d"
	targetPath "bin"
	versions "show_module"
}