name "sarif"
description "uim library for working with SARIF logs using vibe.d and D"
homepage "https://www.sueel.de/uim/sarif"
authors "Ozan Nurettin Süel"
copyright "Copyright © 2018-2026, Ozan Nurettin Süel"
license "Apache-2.0"

targetName "uim-sarif"
targetType "library"

dependency "vibe-d" version="~>0.10.3"
dependency "uim-framework:core" version="*"

buildRequirements "allowWarnings" "silenceDeprecations"
buildOptions "ignoreDeprecations"

configuration "default" {
	targetType "library"
}
