name "i18n"
description "uim library to manage languages and translations, with .properties, .po and .mo files and connectors to external systems"
homepage "https://www.sueel.de/framework/i18n"
authors "Ozan Nurettin Süel"
copyright "Copyright © 2018 - 2026, ONS"
license "Apache-2.0"
dependency "uim-framework:oop" path=".."

targetType "library"
targetPath "build"
targetName "uim-i18n"
sourcePaths "source"
importPaths "source"

configuration "default" {
	targetType "library"
}
configuration "modules" {
	targetType "library"
	versions "show_module"
}
configuration "tests" {
	targetType "library"
	versions "show_module" "show_test"
}
configuration "inits" {
	targetType "library"
	versions "show_module" "show_init"
}
configuration "calls" {
	targetType "library"
	versions "show_module" "show_test" "show_function"
}
configuration "verbose" {
	targetType "library"
	versions "show_module" "show_test" "show_init" "show_function"
}
